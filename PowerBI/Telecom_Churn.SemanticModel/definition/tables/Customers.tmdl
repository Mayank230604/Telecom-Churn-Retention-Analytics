	partition Customers = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\mayan\Downloads\Telecom-Churn-Retention-Analytics\data\processed\power_bi_customers.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Flags = Table.TransformColumns(Headers, {{"is_first_year_month_to_month", each if _ = null then null else Text.Lower(_) = "t", type logical}}),
				    Typed = Table.TransformColumnTypes(Flags, {{"customer_id", type text}, {"customer_status", type text}, {"contract", type text}, {"tenure_in_months", Int64.Type}, {"tenure_band_order", Int64.Type}, {"is_first_year_month_to_month", type logical}, {"city", type text}, {"zip_code", type text}, {"internet_service", type text}, {"internet_type", type text}, {"payment_method", type text}, {"offer", type text}, {"churn_category", type text}, {"churn_reason", type text}, {"monthly_charge", Currency.Type}, {"historical_revenue", Currency.Type}, {"tenure_band", type text}, {"existing_customer_count", Int64.Type}, {"active_customer_count", Int64.Type}, {"churned_customer_count", Int64.Type}, {"active_monthly_charge", Currency.Type}, {"churned_monthly_charge", Currency.Type}}, "en-US")
				in
				    Typed

