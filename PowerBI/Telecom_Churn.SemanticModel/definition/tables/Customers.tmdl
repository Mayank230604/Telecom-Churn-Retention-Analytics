table Customers
	lineageTag: b3255893-9fe8-4b9e-9540-46cdc863e919

	measure 'Total Customers' = COUNTROWS(Customers)
		formatString: #,0
		lineageTag: 5f93210a-77f4-415d-9b98-89f3764475d5

	measure 'Active Customers' = SUM(Customers[active_customer_count])
		formatString: #,0
		lineageTag: bb40c8e1-71bf-48e5-a5b5-d5bd914cf8d6

	measure 'Churned Customers' = SUM(Customers[churned_customer_count])
		formatString: #,0
		lineageTag: e43a1aa9-8302-406d-b8ee-6d33336f6345

	measure 'Existing Customer Churn Rate' = DIVIDE([Churned Customers], SUM(Customers[existing_customer_count]))
		formatString: 0.0%
		lineageTag: 9de43c4d-2a71-44a2-a336-c6bd17713775

	measure 'Active Monthly Charges' = SUM(Customers[active_monthly_charge])
		formatString: $#,0
		lineageTag: 9155457a-62a3-4b68-8670-76737081055d

	measure 'Churned Monthly Charges' = SUM(Customers[churned_monthly_charge])
		formatString: $#,0
		lineageTag: e19ddd76-01cf-4594-98cb-d9f930803f2a

	measure 'Cohort Churn Rate' = CALCULATE([Existing Customer Churn Rate], KEEPFILTERS(Customers[is_first_year_month_to_month] = TRUE()))
		formatString: 0.0%
		lineageTag: 479e7427-8df3-4589-96e6-74bf3df92dac

	measure 'Cohort Active Customers' = CALCULATE([Active Customers], KEEPFILTERS(Customers[is_first_year_month_to_month] = TRUE()))
		formatString: #,0
		lineageTag: 6781da30-8cc8-4226-90dc-a9fd96dccf85

	measure 'Cohort Active Monthly Charges' = CALCULATE([Active Monthly Charges], KEEPFILTERS(Customers[is_first_year_month_to_month] = TRUE()))
		formatString: $#,0
		lineageTag: bcd28076-48f1-4093-b3e0-5861940f70c6

	measure 'Cohort Churned Customers' = CALCULATE([Churned Customers], KEEPFILTERS(Customers[is_first_year_month_to_month] = TRUE()))
		formatString: #,0
		lineageTag: 6773157d-9493-4971-9163-1a04f62ea1d4

	measure 'Cohort Churned Monthly Charges' = CALCULATE([Churned Monthly Charges], KEEPFILTERS(Customers[is_first_year_month_to_month] = TRUE()))
		formatString: $#,0
		lineageTag: 41810489-2bce-4d44-9400-0dd28b28b075

	measure 'Cohort Top Churn Reasons' = VAR Reason = SELECTEDVALUE(Customers[churn_reason]) VAR Candidates = FILTER(ADDCOLUMNS(ALLSELECTED(Customers[churn_reason]), "@Churn", [Cohort Churned Customers]), [@Churn] > 0) VAR TopReasons = TOPN(5, Candidates, [@Churn], DESC, Customers[churn_reason], ASC) RETURN IF(CONTAINS(TopReasons, Customers[churn_reason], Reason), [Cohort Churned Customers])
		formatString: #,0
		lineageTag: 7a0fdad1-7a5c-41c4-91c9-522b5a042761

